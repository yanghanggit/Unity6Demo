/* ===================================================================
   InventoryListView.uss
   适配目标：1080 × 1920 竖屏（PanelSettings 参考分辨率请同步设置）
   =================================================================== */

/* ===== 根容器 ===== */
.root-container {
    width: 100%;
    height: 100%;
    background-color: rgb(12, 14, 22);
    padding: 32px 28px 24px 28px;
    align-items: stretch;
}

/* ===== 按钮 ===== */
.btn {
    height: 62px;
    border-radius: 6px;
    border-width: 0;
    padding: 0 30px;
    color: white;
    -unity-font-style: bold;
    font-size: 26px;
    margin-left: 6px;
}

.btn-add {
    background-color: rgb(38, 120, 60);
}
.btn-add:hover {
    background-color: rgb(48, 150, 75);
}

/* ===== 统计标签 ===== */
.count-label {
    color: rgb(130, 130, 150);
    font-size: 22px;
    margin-bottom: 10px;
}

/* ===== ListView 容器 ===== */
.inventory-list {
    flex-grow: 1;
    background-color: rgb(12, 14, 22);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(40, 42, 60);
    min-height: 300px;
}

/* item wrapper：设为透明，让 ListView 容器的深色背景透出卡片间隙 */
.unity-list-view__item {
    background-color: rgba(0, 0, 0, 0);
}
.unity-list-view__item--even {
    background-color: rgba(0, 0, 0, 0);
}
.unity-list-view__item--odd {
    background-color: rgba(0, 0, 0, 0);
}

/* 选中高亮：outer wrapper 遮住了 item 背景，所以改在 card 上显示选中色 */
.unity-list-view__item:checked .list-item-card {
    background-color: rgb(70, 95, 165);
}

/* ===== 列表项卡片容器 ===== */
/* fixedItemHeight=144：outer.padding(16×2) + card(flex-grow→112px) = 144 */
.list-item-card {
    flex-grow: 1;
    background-color: rgb(55, 68, 120);
    border-radius: 8px;
    justify-content: center;
}

/* ===== 列表项文字 ===== */
.list-item-label {
    color: rgb(220, 220, 220);
    font-size: 28px;
    padding: 0 24px;
    -unity-text-align: middle-left;
}


