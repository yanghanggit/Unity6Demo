/* ===================================================================
   InventoryListView.uss
   适配目标：1080 × 1920 竖屏（PanelSettings 参考分辨率请同步设置）
   =================================================================== */

/* ===== 根容器 ===== */
.root-container {
    width: 100%;
    height: 100%;
    background-color: rgb(18, 18, 28);
    padding: 32px 28px 24px 28px;
    align-items: stretch;
}

/* ===== 按钮 ===== */
.btn {
    height: 62px;
    border-radius: 6px;
    border-width: 0;
    padding: 0 30px;
    color: white;
    -unity-font-style: bold;
    font-size: 26px;
    margin-left: 6px;
}

.btn-add {
    background-color: rgb(38, 120, 60);
}
.btn-add:hover {
    background-color: rgb(48, 150, 75);
}

/* ===== 统计标签 ===== */
.count-label {
    color: rgb(130, 130, 150);
    font-size: 22px;
    margin-bottom: 10px;
}

/* ===== ListView 容器 ===== */
.inventory-list {
    flex-grow: 1;
    background-color: rgb(24, 24, 38);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(55, 55, 75);
    min-height: 300px;
}

/* Unity 内置交替行背景 */
.unity-list-view__item--even {
    background-color: rgb(30, 30, 44);
}

.unity-list-view__item--odd {
    background-color: rgb(24, 24, 38);
}

/* 选中高亮 */
.unity-list-view__item:checked {
    background-color: rgb(50, 80, 130);
}

/* ===== 列表项 Label =====
   makeItem 返回一个 Label 并添加此 class；
   bindItem 只负责设置 label.text，其余样式全在这里。 */
.list-item-label {
    flex-grow: 1;
    color: rgb(220, 220, 220);
    font-size: 28px;
    padding: 0 24px;
    -unity-text-align: middle-left;
}


