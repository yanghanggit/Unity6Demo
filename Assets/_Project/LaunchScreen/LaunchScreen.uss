/* ===================================================================
   LaunchScreen.uss
   适配目标：1080 × 1920 竖屏（PanelSettings 参考分辨率请同步设置）
   =================================================================== */

/* ===== 根容器：全屏、深色背景、内容居中 ===== */
.root-container {
    width: 100%;
    height: 100%;
    background-color: rgb(12, 14, 22);
    justify-content: center;
    align-items: center;
}

/* ===== 状态提示文字：加载中 / 连接失败 ===== */
.status-label {
    color: rgb(130, 130, 150);
    font-size: 24px;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
    min-height: 32px;
}

/* ===== 开始按钮：胶囊形状，绿色主色调 ===== */
.btn-start {
    width: 400px;
    height: 110px;
    border-radius: 55px;
    border-width: 0;
    background-color: rgb(38, 120, 60);
    color: white;
    -unity-font-style: bold;
    font-size: 36px;
    -unity-text-align: middle-center;
}

.btn-start:hover {
    background-color: rgb(48, 150, 75);
}

.btn-start:disabled {
    opacity: 0.5;
}
